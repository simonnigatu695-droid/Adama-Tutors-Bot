LANGUAGES = ("en", "am", "om")


def t(lang: str, key: str, **kwargs) -> str:
    """Return message `key` in `lang` (falls back to English)."""
    entry = T[key]
    text = entry.get(lang) or entry["en"]
    return text.format(**kwargs) if kwargs else text
